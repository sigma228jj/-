    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name">CrystalRiftConfig</string>
        <string name="Source"><![CDATA[-- Общие настройки способности «Кристальный разлом» (сервер + клиент).
local Config = {
	RemoteName = "CrystalRiftRemote",
	EffectsFolderName = "CrystalRiftEffects",

	-- Управление: зажать — прицел, отпустить — каст
	Key = Enum.KeyCode.E,
	GamepadKey = Enum.KeyCode.ButtonY,

	Cooldown = 6,
	MinRange = 12,
	MaxRange = 70,

	-- Волна шипов
	StartOffset = 4, -- первый шип на таком расстоянии от игрока
	SpikeSpacing = 3.5,
	SpikeDelay = 0.045,
	SpikeWidth = 2.2,
	SpikeHeightMin = 4,
	SpikeHeightMax = 10, -- шипы растут по мере удаления от игрока
	SpikeLean = 0.35, -- наклон шипов по направлению волны
	SpikeJitter = 0.25,
	RiseTime = 0.22,
	MaxStepHeight = 6, -- перепад выше — волна упирается в препятствие

	-- Урон по пути
	HitRadius = 5,
	Damage = 20,
	KnockUp = 45,
	KnockBack = 18,
	SlowMultiplier = 0.45,
	SlowDuration = 1.6,
	FriendlyFire = false,

	-- Финальный взрыв
	FinaleSpikes = 7,
	FinaleRadius = 12,
	FinaleDamage = 30,
	FinaleCenterHeight = 16,

	-- Разрушение
	Lifetime = 2.2,
	ShardsPerSpike = 5,
	ShardLifetime = 1.6,

	GroundProbeUp = 15,
	GroundProbeDown = 40,

	Color = Color3.fromRGB(110, 205, 255),
	CoreColor = Color3.fromRGB(220, 250, 255),
}

return Config
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">KatanaConfig</string>
        <string name="Source"><![CDATA[-- Общие настройки катаны (сервер + клиент).
return {
	RemoteName = "KatanaRemote",
	EffectsFolderName = "KatanaEffects",
	ToolName = "Катана",

	Color = Color3.fromRGB(255, 60, 100), -- свечение лезвия и эффектов
	CoreColor = Color3.fromRGB(255, 220, 230),

	Keys = {
		Wave = Enum.KeyCode.Q,
		Dash = Enum.KeyCode.R,
		Ultimate = Enum.KeyCode.F,
	},

	-- ЛКМ: комбо из трёх ударов, третий — добивающий с отбросом
	Slash = {
		Cooldown = 0.35,
		ComboWindow = 0.9,
		Damage = { 14, 16, 28 },
		Range = 8,
		Width = 9,
		FinisherKnock = 45,
	},

	-- Q: летящая волна-полумесяц, пробивает всех на пути
	Wave = {
		Cooldown = 4,
		Damage = 30,
		Speed = 95,
		Range = 120,
		Width = 14,
		Height = 6,
	},

	-- R: рывок сквозь врагов с порезами
	Dash = {
		Cooldown = 5,
		Damage = 28,
		Distance = 34,
		Width = 7,
	},

	-- F: буря клинков — серия ударов вокруг + финальный взрыв
	Ultimate = {
		Cooldown = 18,
		Hits = 8,
		Interval = 0.12,
		Damage = 10,
		Radius = 16,
		FinalDamage = 40,
	},
}
]]></string>
      </Properties>
    </Item>
